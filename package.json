{
  "name": "docspring-ts",
  "version": "4.0.0",
  "description": "An API client for the DocSpring PDF generation service",
  "author": "DocSpring",
  "repository": {
    "type": "git",
    "url": "https://github.com/DocSpring/docspring-typescript.git"
  },
  "keywords": [
    "fetch",
    "typescript",
    "openapi-client",
    "openapi-generator"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "type": "commonjs",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "typings": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build"
  },
  "dependencies": {
    "es6-promise": "^4.2.4",
    "whatwg-fetch": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "typescript": "^5.0"
  },
  "homepage": "https://github.com/DocSpring/docspring-typescript#readme",
  "bugs": {
    "url": "https://github.com/DocSpring/docspring-typescript/issues"
  }
}
